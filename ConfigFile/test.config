server
{
    listen 8080;
    host 127.0.0.1;
    root ./www;
    index index.html;
    client_max_body_size 10M;

    location /
    {
        allow_methods GET POST;
    }

    location /cgi-bin
    {
        allow_methods GET POST;
        cgi_ext .py;
        cgi_path /opt/pyenv/shims/python3;
    }

    location /uploads
    {
        allow_methods GET POST DELETE;
        upload_store ./www/uploads;
        autoindex on;
    }
}